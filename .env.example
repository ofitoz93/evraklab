# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Supabase Dashboard > Project Settings > API > service_role key. SADECE
# sunucu tarafında (api/ altında) kullanılır, asla tarayıcıya gönderilmez,
# asla VITE_ öneki almamalı. PayTR callback'i (ve gelecekte benzer webhook'lar)
# bu key ile RLS'yi bypass ederek oturumsuz yazma yapar.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini AI API Configuration
VITE_GEMINI_API_KEY=your-gemini-api-key

# PayTR Ödeme Altyapısı (https://www.paytr.com/magaza-paneli/bilgilerim)
# Bu üçü boş kaldığı sürece ödeme sistemi devre dışı kalır, uygulama
# çökmez ("Ödeme sistemi henüz yapılandırılmadı" hatası döner).
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# 1 = test modu (sahte kartlarla denenir, gerçek para çekilmez), 0 = canlı
PAYTR_TEST_MODE=1
# PayTR'ın merchant_ok_url/merchant_fail_url'i oluşturmak için kullanılan,
# sondaki / olmadan tam site adresi (örn. https://evraklab.com)
APP_BASE_URL=http://localhost:5173

# Android/iOS (Capacitor) native uygulaması, kendi yerel origin'inden servis
# edildiği için "/api/*" isteklerini (src/apiBase.ts > apiUrl) bu adrese mutlak
# URL olarak gönderir. Sondaki / olmadan, gerçek yayındaki (production) adres.
VITE_APP_BASE_URL=https://evraklab.com
